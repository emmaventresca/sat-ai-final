# Copy to .env.local and fill in from the Supabase dashboard (Project settings
# -> API). Without these the app runs in LOCAL mode: accounts live in one
# browser and teacher codes are NOT secure.
#
# Then run, in the SQL editor, in order:
#   supabase/schema.sql
#   supabase/teacher_codes.sql
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
