# Corpus: large, reproducible, and College Board's copyright. Regenerate with
# tools/fetch_bank.py and tools/fetch_tests.py rather than committing it.
corpus/bank/
corpus/tests/*.pdf
corpus/*.log

.DS_Store
.env
__pycache__/

# College Board item text: cached locally, never redistributed.
data/items.json

# College Board's answer explanations: their expression, not fact. The derived
# answer keys (question number -> letter) are tracked; the prose is not.
corpus/tests/*-explanations.json

# Classification working set: derived from College Board rationale text.
corpus/classify/
